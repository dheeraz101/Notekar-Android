<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="14dp"
    android:background="@drawable/notekar_widget_background">

    <!-- Top Label -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/widget_minimal_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SOBRIETY"
            android:textColor="#FFFFD60A"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- Main Days Counter -->
    <TextView
        android:id="@+id/widget_minimal_days"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0d Clean"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:includeFontPadding="false" />

    <!-- Live Ticking Chronometer (Hours : Minutes : Seconds) -->
    <Chronometer
        android:id="@+id/widget_minimal_chronometer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="#B3FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:includeFontPadding="false" />

    <!-- Subtitle / Status -->
    <TextView
        android:id="@+id/widget_minimal_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Tap to open settings"
        android:textColor="#66FFFFFF"
        android:textSize="9.5sp"
        android:includeFontPadding="false" />

</LinearLayout>
