<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/notekar_widget_background">

    <!-- Content Panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.0"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:gravity="center_vertical">

        <!-- Left Column: Intentionality Gauge Badge -->
        <LinearLayout
            android:id="@+id/widget_audit_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:background="@drawable/notekar_widget_card">

            <TextView
                android:id="@+id/widget_audit_ratio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="#FF30D158"
                android:textSize="22sp"
                android:fontFamily="sans-serif-black"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_audit_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="FOCUS"
                android:textColor="#80FFFFFF"
                android:textSize="9sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:includeFontPadding="false" />
        </LinearLayout>

        <View
            android:id="@+id/widget_audit_spacer"
            android:layout_width="10dp"
            android:layout_height="match_parent" />

        <!-- Right Column: Today's Time Budget & Intentionality Details -->
        <LinearLayout
            android:id="@+id/widget_audit_details"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.9"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:padding="4dp">

            <TextView
                android:id="@+id/widget_audit_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIFE AUDIT • TODAY"
                android:textColor="#FF30D158"
                android:textSize="9.5sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_audit_tracked"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="0m intentional tracked"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_audit_wasted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Void: 0m unrecorded"
                android:textColor="#B3FFFFFF"
                android:textSize="9.5sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Actions Dock: IN, OUT, NOTE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_in"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:text="IN"
            android:textColor="#FF30D158"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:background="@drawable/notekar_widget_button" />

        <TextView
            android:id="@+id/widget_out"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:gravity="center"
            android:text="OUT"
            android:textColor="#FFFF453A"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:background="@drawable/notekar_widget_button" />

        <TextView
            android:id="@+id/widget_note"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:text="NOTE"
            android:textColor="#FF0A84FF"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:background="@drawable/notekar_widget_button" />
    </LinearLayout>

</LinearLayout>
