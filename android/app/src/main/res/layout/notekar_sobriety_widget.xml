<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/notekar_widget_background">

    <!-- Content Panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.0"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:gravity="center_vertical">

        <!-- Left Column: Streak circular badge / container -->
        <LinearLayout
            android:id="@+id/widget_streak_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:background="@drawable/notekar_widget_card">

            <TextView
                android:id="@+id/widget_streak_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0d"
                android:textColor="#FFFFD60A"
                android:textSize="22sp"
                android:fontFamily="sans-serif-black"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_streak_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="CLEAN"
                android:textColor="#80FFFFFF"
                android:textSize="9sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:includeFontPadding="false" />
        </LinearLayout>

        <View
            android:id="@+id/widget_spacer"
            android:layout_width="10dp"
            android:layout_height="match_parent" />

        <!-- Right Column: Milestone Details -->
        <LinearLayout
            android:id="@+id/widget_details_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.9"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:padding="4dp">

            <TextView
                android:id="@+id/widget_sobriety_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SOBRIETY ACTIVE"
                android:textColor="#FF9F0A"
                android:textSize="9.5sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_streak_milestone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Clean Streak"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_last_relapse_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="No relapse recorded"
                android:textColor="#B3FFFFFF"
                android:textSize="9.5sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Actions Dock (Sleek Horizontal Row) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_single"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:gravity="center"
            android:text="RESET STREAK"
            android:textColor="#FFFF453A"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:background="@drawable/notekar_widget_button" />

        <TextView
            android:id="@+id/widget_note"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:gravity="center"
            android:text="ADD DIARY"
            android:textColor="#FF0A84FF"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:background="@drawable/notekar_widget_button" />
    </LinearLayout>

</LinearLayout>
