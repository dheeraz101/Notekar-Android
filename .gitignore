# ----------------------------------------------------------------------
# NoteKar Android (Flutter) Master .gitignore
# Ensures ZERO sensitive keys, build outputs, local metadata, or
# developer scratch files are ever committed to GitHub.
# ----------------------------------------------------------------------

# 🔑 Android Signing Secrets & Passwords (CRITICAL - NEVER COMMIT)
**/key.properties
**/key.properties.*
**/local.properties
**/*.jks
**/*.keystore
**/*.pem
**/*.p12
**/*.pkcs12
**/*.crt
**/*.cer
**/*.der
**/*.key
**/*.asc
**/*.bks
**/*.pfx
**/upload-keystore.jks
**/debug.keystore
**/release-key.jks

# 🔐 API Secrets, Cloud Configs & Environment Files
**/.env
**/.env.*
!.env.example
**/*.env
**/secrets.json
**/credentials.json
**/service-account*.json
**/client_secret*.json
**/google-services.json
**/GoogleService-Info.plist
**/firebase_options.dart

# 🛠️ Flutter Workspace Metadata & Dependency Files
.metadata
**/.metadata
.flutter-plugins-dependencies
**/.flutter-plugins-dependencies
.flutter-plugins
**/.flutter-plugins
.packages
**/.packages
**/.pub-cache/
**/.pub/
doc/api/

# 🏗️ Build Artifacts, Cache & Generated Code
build/
**/build/
**/coverage/
.dart_tool/
**/.dart_tool/
.gradle/
**/.gradle/
.kotlin/
**/.kotlin/
.cxx/
**/.cxx/
**/captures/
**/*.hprof
**/*.dex
**/*.class
**/GeneratedPluginRegistrant.java
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/ios/Pods/
**/ios/.symlinks/

# 📱 Local Releases, APKs, Bundles & Binaries (CRITICAL: No Binaries in Git)
releases/**/*
!releases/**/
versions/**/*
!versions/**/

release/
**/release/
output/
**/output/

**/*.apk
**/*.aab
**/*.idsig
**/*.sha1
**/*.sha256
**/*.dll
**/*.so
**/*.dylib
**/*.exe
isar.dll

# 🚀 Un-ignore Release Documentation (MD and JSON files ONLY)
!releases/**/*.md
!versions/**/*.json
**/version.json
**/sha256.txt

# 💻 IDEs, Editors & Module Files
.idea/
**/.idea/
*.iml
**/*.iml
*.ipr
**/*.ipr
*.iws
**/*.iws
out/
**/out/
.vscode/
**/.vscode/
.atom/
.history
.svn/
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/
.buildpath
*.swp
*.swo

